@charset "utf-8";

:root { --espresso: #2B1A12; --brown: #3E2A1E; --brown-2: #4A3223; --gold: #D4A135; --gold-light: #E8C36A; --terracotta: #C15B32; --terracotta-dark: #A84A26; --cream: #FAF3E7; --cream-2: #F3E7D3; --sand: #E9D9BD; --ink: #2A1B10; --muted: #7A6248; --white: #FFFDF8; --shadow-sm: 0 2px 10px rgba(43,26,18,.08); --shadow-md: 0 12px 32px rgba(43,26,18,.14); --shadow-lg: 0 24px 60px rgba(43,26,18,.22); --radius: 18px; --serif: 'Fraunces',Georgia,serif; --sans: 'Manrope',system-ui,-apple-system,sans-serif; }

*, ::before, ::after { margin: 0px; padding: 0px; box-sizing: border-box; }

html { scroll-behavior: smooth; scroll-padding-top: 88px; }

body { font-family: var(--sans); color: var(--ink); background: var(--cream); line-height: 1.7; font-size: 16.5px; -webkit-font-smoothing: antialiased; overflow-x: hidden; }

img { max-width: 100%; display: block; }

a { text-decoration: none; color: inherit; }

ul { list-style: none; }

.container { width: min(1160px, 92%); margin-inline: auto; }

.section { padding: clamp(72px, 9vw, 116px) 0px; }

.section-head { max-width: 720px; margin: 0px auto clamp(44px, 6vw, 64px); text-align: center; }

.eyebrow { display: inline-flex; align-items: center; gap: 10px; font-size: 0.78rem; font-weight: 800; letter-spacing: 0.22em; text-transform: uppercase; color: var(--terracotta); margin-bottom: 16px; }

.eyebrow::before, .eyebrow.center::after { content: ""; width: 34px; height: 2px; background: var(--gold); border-radius: 2px; }

.eyebrow.center::after { content: ""; }

h1, h2, h3, h4 { font-family: var(--serif); font-weight: 600; line-height: 1.15; color: var(--ink); }

h2 { font-size: clamp(1.9rem, 3.6vw, 2.75rem); letter-spacing: -0.01em; }

.lead { color: var(--muted); font-size: 1.06rem; }

.btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; padding: 15px 30px; border-radius: 999px; font-weight: 700; font-size: 0.95rem; letter-spacing: 0.02em; transition: 0.28s; cursor: pointer; border: 2px solid transparent; white-space: nowrap; }

.btn-gold { background: var(--gold); color: var(--espresso); box-shadow: rgba(212, 161, 53, 0.32) 0px 10px 24px; }

.btn-gold:hover { background: var(--gold-light); transform: translateY(-2px); box-shadow: rgba(212, 161, 53, 0.42) 0px 16px 32px; }

.btn-ghost { background: transparent; color: var(--cream); border-color: rgba(250, 243, 231, 0.4); }

.btn-ghost:hover { border-color: var(--gold); color: var(--gold-light); transform: translateY(-2px); }

.btn-dark { background: var(--espresso); color: var(--cream); }

.btn-dark:hover { background: var(--brown-2); transform: translateY(-2px); }

.btn svg { flex: 0 0 auto; }

.topbar { background: var(--espresso); color: rgba(250, 243, 231, 0.82); font-size: 0.82rem; padding: 9px 0px; }

.topbar .container { display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap; }

.topbar span { display: inline-flex; align-items: center; gap: 7px; }

.topbar .tb-right { display: flex; gap: 22px; align-items: center; }

.topbar a:hover { color: var(--gold-light); }

.nav { position: sticky; top: 0px; z-index: 100; background: rgba(43, 26, 18, 0.92); backdrop-filter: blur(14px); border-bottom: 1px solid rgba(212, 161, 53, 0.18); transition: box-shadow 0.3s; }

.nav.scrolled { box-shadow: rgba(0, 0, 0, 0.25) 0px 8px 30px; }

.nav .container { display: flex; align-items: center; justify-content: space-between; height: 76px; }

.brand { display: flex; align-items: center; gap: 12px; }

.brand-mark { width: 44px; height: 44px; border-radius: 12px; background: linear-gradient(145deg,var(--terracotta),#8E3B1D); display: grid; place-items: center; color: var(--cream); font-family: var(--serif); font-weight: 700; font-size: 1.05rem; box-shadow: rgba(255, 255, 255, 0.18) 0px 0px 0px 1.5px inset, rgba(0, 0, 0, 0.28) 0px 6px 14px; flex: 0 0 auto; }

.brand-logo { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; flex: 0 0 auto; background: var(--espresso); box-shadow: rgba(212, 161, 53, 0.5) 0px 0px 0px 2px, rgba(0, 0, 0, 0.35) 0px 6px 14px; transition: transform 0.3s; }

.brand:hover .brand-logo { transform: scale(1.06) rotate(-2deg); }

.brand-name { color: var(--cream); font-family: var(--serif); font-weight: 700; font-size: 1.28rem; letter-spacing: 0.01em; line-height: 1.1; }

.brand-name em { font-style: normal; color: var(--gold); }

.brand-sub { display: block; font-family: var(--sans); font-size: 0.62rem; font-weight: 700; letter-spacing: 0.3em; text-transform: uppercase; color: rgba(250, 243, 231, 0.6); margin-top: 2px; }

.nav-links { display: flex; align-items: center; gap: 34px; }

.nav-links a { color: rgba(250, 243, 231, 0.85); font-weight: 600; font-size: 0.94rem; position: relative; padding: 6px 0px; transition: color 0.25s; }

.nav-links a::after { content: ""; position: absolute; left: 0px; bottom: 0px; width: 0px; height: 2px; background: var(--gold); border-radius: 2px; transition: width 0.28s; }

.nav-links a:hover { color: var(--gold-light); }

.nav-links a:hover::after { width: 100%; }

.nav-cta { padding: 11px 22px; font-size: 0.88rem; }

.nav-toggle { display: none; background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; cursor: pointer; width: 42px; height: 42px; border-radius: 10px; place-items: center; color: var(--cream); }

.nav-toggle svg { width: 26px; height: 26px; }

.hero { position: relative; min-height: 92vh; display: flex; align-items: center; color: var(--cream); background: var(--espresso); overflow: hidden; }

.hero-bg { position: absolute; inset: 0px; background: url("images/hero.jpg") center center / cover no-repeat; transform: scale(1.02); animation: 18s ease-out 0s 1 normal forwards running heroZoom; }

@keyframes heroZoom { 
  0% { transform: scale(1.1); }
  100% { transform: scale(1.02); }
}

.hero::before { content: ""; position: absolute; inset: 0px; background: linear-gradient(100deg, rgba(30, 16, 9, 0.94) 0%, rgba(30, 16, 9, 0.78) 42%, rgba(30, 16, 9, 0.38) 72%, rgba(30, 16, 9, 0.62) 100%); }

.hero::after { content: ""; position: absolute; inset: 0px; background: radial-gradient(at 22% 70%, rgba(193, 91, 50, 0.22), transparent 55%); }

.hero-inner { position: relative; z-index: 2; padding: clamp(96px, 13vh, 140px) 0px; max-width: 680px; }

.hero .eyebrow { color: var(--gold-light); }

.hero h1 { color: var(--cream); font-size: clamp(2.6rem, 6vw, 4.5rem); font-weight: 700; letter-spacing: -0.02em; line-height: 1.06; margin-bottom: 8px; }

.hero h1 .accent { color: var(--gold); }

.hero .tagline { font-family: var(--serif); font-style: italic; font-size: clamp(1.15rem, 2.2vw, 1.55rem); color: var(--gold-light); margin-bottom: 24px; font-weight: 500; }

.hero p.sub { color: rgba(250, 243, 231, 0.82); font-size: 1.07rem; max-width: 540px; margin-bottom: 38px; }

.hero-actions { display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 52px; }

.hero-trust { display: flex; gap: clamp(18px, 3.4vw, 44px); flex-wrap: wrap; border-top: 1px solid rgba(250, 243, 231, 0.18); padding-top: 26px; }

.trust-item { display: flex; flex-direction: column; gap: 2px; }

.trust-item b { font-family: var(--serif); font-size: 1.28rem; color: var(--gold-light); font-weight: 600; }

.trust-item span { font-size: 0.82rem; color: rgba(250, 243, 231, 0.68); letter-spacing: 0.06em; text-transform: uppercase; font-weight: 600; }

.about { background: var(--cream); position: relative; }

.about-grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: clamp(36px, 5vw, 72px); align-items: center; }

.about-copy h2 { margin-bottom: 22px; }

.about-copy p { color: var(--muted); margin-bottom: 18px; }

.about-copy p strong { color: var(--espresso); }

.about-features { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 30px; }

.feat { display: flex; align-items: center; gap: 12px; background: var(--white); border: 1px solid var(--sand); border-radius: 14px; padding: 14px 16px; font-weight: 600; font-size: 0.92rem; box-shadow: var(--shadow-sm); }

.feat-icon { width: 38px; height: 38px; flex: 0 0 auto; border-radius: 10px; background: var(--cream-2); display: grid; place-items: center; color: var(--terracotta); }

.about-visual { position: relative; }

.about-visual .frame { border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow-lg); position: relative; }

.about-visual .frame img { width: 100%; height: 520px; object-fit: cover; }

.about-badge { position: absolute; left: -18px; bottom: 34px; background: var(--espresso); color: var(--cream); border-radius: 16px; padding: 18px 22px; box-shadow: var(--shadow-lg); display: flex; align-items: center; gap: 14px; max-width: 280px; border: 1px solid rgba(212, 161, 53, 0.35); }

.about-badge b { font-family: var(--serif); font-size: 1.7rem; color: var(--gold); font-weight: 700; line-height: 1; }

.about-badge span { font-size: 0.8rem; color: rgba(250, 243, 231, 0.78); line-height: 1.35; }

.mission { background: var(--espresso); color: var(--cream); position: relative; overflow: hidden; }

.mission::before { content: ""; position: absolute; inset: 0px; background: radial-gradient(circle at 85% 15%, rgba(193, 91, 50, 0.22), transparent 48%), radial-gradient(circle at 8% 90%, rgba(212, 161, 53, 0.14), transparent 45%); }

.mission .container { position: relative; z-index: 1; }

.mission .section-head h2 { color: var(--cream); }

.mission .eyebrow { color: var(--gold-light); }

.mission-statement { max-width: 820px; margin: 0px auto 56px; text-align: center; }

.mission-statement p { font-family: var(--serif); font-size: clamp(1.3rem, 2.6vw, 1.85rem); font-weight: 500; line-height: 1.5; color: var(--cream); font-style: italic; }

.mission-statement p span { color: var(--gold-light); }

.mission-pillars { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }

.pillar { background: rgba(250, 243, 231, 0.05); border: 1px solid rgba(212, 161, 53, 0.22); border-radius: var(--radius); padding: 32px 28px; transition: transform 0.3s, background 0.3s; }

.pillar:hover { transform: translateY(-6px); background: rgba(250, 243, 231, 0.09); }

.pillar-icon { width: 52px; height: 52px; border-radius: 14px; background: linear-gradient(145deg,var(--gold),#B07F1F); display: grid; place-items: center; margin-bottom: 20px; box-shadow: rgba(212, 161, 53, 0.3) 0px 10px 22px; }

.pillar h3 { color: var(--gold-light); font-size: 1.22rem; margin-bottom: 10px; }

.pillar p { color: rgba(250, 243, 231, 0.74); font-size: 0.95rem; }

.products { background: var(--cream-2); }

.products-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }

.product-card { background: var(--white); border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow-sm); transition: transform 0.32s, box-shadow 0.32s; display: flex; flex-direction: column; border: 1px solid var(--sand); }

.product-card:hover { transform: translateY(-8px); box-shadow: var(--shadow-md); }

.product-media { position: relative; height: 230px; overflow: hidden; }

.product-media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s; }

.product-card:hover .product-media img { transform: scale(1.08); }

.product-tag { position: absolute; top: 14px; left: 14px; background: rgba(43, 26, 18, 0.82); backdrop-filter: blur(6px); color: var(--gold-light); font-size: 0.68rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; padding: 7px 12px; border-radius: 999px; border: 1px solid rgba(212, 161, 53, 0.4); }

.product-body { padding: 24px 22px 26px; display: flex; flex-direction: column; flex: 1 1 0%; }

.product-body h3 { font-size: 1.22rem; margin-bottom: 8px; }

.product-body p { color: var(--muted); font-size: 0.9rem; flex: 1 1 0%; }

.product-meta { display: flex; align-items: center; justify-content: space-between; margin-top: 18px; padding-top: 16px; border-top: 1px dashed var(--sand); font-size: 0.8rem; font-weight: 700; color: var(--terracotta); }

.product-meta span { color: var(--muted); font-weight: 600; }

.products-note { text-align: center; margin-top: 44px; color: var(--muted); font-size: 0.98rem; }

.products-note a { color: var(--terracotta); font-weight: 700; border-bottom: 2px solid var(--gold); padding-bottom: 2px; transition: color 0.25s; }

.products-note a:hover { color: var(--terracotta-dark); }

.commitment { background: var(--cream); }

.commitment-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(36px, 5vw, 72px); align-items: center; }

.commitment-visual { position: relative; }

.commitment-visual .frame { border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow-lg); position: relative; }

.commitment-visual .frame img { width: 100%; height: 520px; object-fit: cover; }

.commitment-quote { position: absolute; right: -16px; top: -22px; background: var(--gold); color: var(--espresso); border-radius: 50%; width: 92px; height: 92px; display: grid; place-items: center; text-align: center; font-family: var(--serif); font-weight: 700; font-size: 0.95rem; line-height: 1.15; box-shadow: var(--shadow-md); border: 4px solid var(--cream); transform: rotate(4deg); }

.commitment-copy h2 { margin-bottom: 22px; }

.commitment-copy > p { color: var(--muted); margin-bottom: 16px; }

.commitment-copy > p strong { color: var(--espresso); }

.commitment-list { margin-top: 28px; display: grid; gap: 16px; }

.commitment-list li { display: flex; gap: 16px; align-items: flex-start; background: var(--white); border: 1px solid var(--sand); border-radius: 14px; padding: 18px 20px; box-shadow: var(--shadow-sm); transition: transform 0.28s; }

.commitment-list li:hover { transform: translateX(6px); }

.commitment-list .ck { width: 40px; height: 40px; flex: 0 0 auto; border-radius: 50%; background: var(--cream-2); color: var(--terracotta); display: grid; place-items: center; margin-top: 2px; }

.commitment-list b { display: block; font-size: 0.98rem; margin-bottom: 2px; }

.commitment-list span { color: var(--muted); font-size: 0.88rem; }

.closing { position: relative; background: url("images/hero.jpg") center center / cover no-repeat fixed; color: var(--cream); text-align: center; padding: clamp(90px, 11vw, 150px) 0px; }

.closing::before { content: ""; position: absolute; inset: 0px; background: linear-gradient(rgba(38, 21, 12, 0.9), rgba(43, 26, 18, 0.94)); }

.closing .container { position: relative; z-index: 1; }

.closing .ornament { display: flex; align-items: center; justify-content: center; gap: 16px; margin-bottom: 26px; color: var(--gold); }

.closing .ornament::before, .closing .ornament::after { content: ""; width: 70px; height: 1.5px; background: linear-gradient(90deg,transparent,var(--gold)); }

.closing .ornament::after { background: linear-gradient(90deg,var(--gold),transparent); }

.closing h2 { color: var(--cream); font-size: clamp(2.2rem, 4.6vw, 3.4rem); font-weight: 700; margin-bottom: 18px; }

.closing p { font-family: var(--serif); font-style: italic; font-size: clamp(1.15rem, 2.2vw, 1.5rem); color: var(--gold-light); max-width: 720px; margin: 0px auto 40px; }

.contact { background: var(--cream-2); }

.contact-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(32px, 4.5vw, 64px); align-items: stretch; }

.contact-info { background: var(--espresso); color: var(--cream); border-radius: var(--radius); padding: clamp(30px, 4vw, 46px); box-shadow: var(--shadow-lg); display: flex; flex-direction: column; position: relative; overflow: hidden; }

.contact-info::after { content: ""; position: absolute; top: -60px; right: -60px; width: 200px; height: 200px; border-radius: 50%; background: radial-gradient(circle, rgba(212, 161, 53, 0.25), transparent 70%); }

.contact-info h3 { color: var(--gold-light); font-size: 1.5rem; margin-bottom: 10px; }

.contact-info > p { color: rgba(250, 243, 231, 0.72); font-size: 0.95rem; margin-bottom: 28px; }

.contact-rows { display: grid; gap: 16px; margin-top: auto; }

.contact-row { display: flex; align-items: center; gap: 16px; background: rgba(250, 243, 231, 0.06); border: 1px solid rgba(212, 161, 53, 0.2); border-radius: 14px; padding: 16px 18px; transition: background 0.25s, transform 0.25s; }

.contact-row:hover { background: rgba(250, 243, 231, 0.1); transform: translateX(4px); }

.contact-row .c-icon { width: 46px; height: 46px; flex: 0 0 auto; border-radius: 12px; background: linear-gradient(145deg,var(--gold),#B07F1F); display: grid; place-items: center; color: var(--espresso); }

.contact-row .c-label { display: block; font-size: 0.7rem; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(250, 243, 231, 0.55); }

.contact-row .c-value { font-weight: 700; font-size: 1.02rem; color: var(--cream); word-break: break-word; }

